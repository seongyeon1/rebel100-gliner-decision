# Run: bash docker_run.sh setup (auto-detects local SDK images).
# If none is available, set a vendor-provided image that matches the host driver.
RBLN_BASE_IMAGE=
SDK_PYTHON=python3
RBLN_CDI_DEVICE=rebellions.ai/npu=0
NPU_DEVICE=0
DECISION_API_KEY=
BACKEND=rbln-compile
DTYPE=float16
BUCKET=256
CPU_THREADS=4
MAX_PENDING=8
BIND_ADDRESS=127.0.0.1
PORT=8009
WARMUP=3
REPEATS=20
DATASET=/app/examples.jsonl
